FROM alpine:latest@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a as builder

RUN apk --no-cache add 'ca-certificates>=20261020-r0'

FROM scratch

COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

ADD release/linux/arm64/drone-aws-oidc /bin/

ENTRYPOINT ["/bin/drone-aws-oidc"]